{
  "optim": {
    "name": "adamw",
    "lr": 0.0002,
    "weight_decay": 0.0001,
    "warmup_steps": 500,
    "epochs": 150,
    "early_stop_patience": 20,
    "batch_size": 4,
    "grad_accum_steps": 1,
    "grad_clip": 1.0,
    "amp": true,
    "num_workers": 4
  },
  "diagnostics": {
    "centroid_radius_px": 5,
    "perturbations": {
      "noise_std": 0.01,
      "intensity_scale": 0.9,
      "intensity_bias": 0.05
    },
    "gates": {
      "target_energy_precision_min": 0.8,
      "source_false_activation_max": 0.2,
      "background_target_leakage_max": 0.3,
      "psf_residual_overlap_max": 0.5,
      "uncertainty_error_spearman_min": 0.3,
      "residual_energy_ratio_max": 0.9,
      "residual_target_fraction_max": 0.5,
      "target_psf_zero_fraction_max": 0.25,
      "background_input_correlation_max": 0.999,
      "flip_intensity_correlation_min": 0.9,
      "noise_correlation_min": 0.8
    }
  },
  "run": {
    "seed": 42,
    "checkpoint_interval": 10,
    "keep_milestones": true
  },
  "model": {
    "in_ch": 1,
    "dims": [
      32,
      64,
      128
    ],
    "num_psf": 6,
    "kernel_size": 15,
    "sigma_min": 0.6,
    "sigma_max": 4.0,
    "source_flux_scale": 16.0
  },
  "loss": {
    "weights": {
      "rec": 1.0,
      "bg": 1.0,
      "center": 0.5,
      "sparse": 0.05,
      "target": 0.5,
      "residual": 0.05,
      "independence": 0.05,
      "psf_diversity": 0.01,
      "uncertainty": 0.01
    },
    "focal_alpha": 0.95,
    "focal_gamma": 2.0
  },
  "data": {
    "root": "data/IRSTD-1K",
    "train_split": "train",
    "test_split": "test",
    "val_count": 80,
    "split_seed": 42,
    "dilation_radius": 3,
    "ring_radius": 9,
    "sirst_uavb_root": "data/SIRST-UAVB_OnlyUAV_Form",
    "sirst4_root": "data/SIRST4-ForLiTE"
  }
}
